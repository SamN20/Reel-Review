APP_ENV_FILE=.env.beta
COMPOSE_PROJECT_NAME=reelreview-beta
PROJECT_NAME=Reel-Review Beta
FRONTEND_URL=https://beta-reelreview.bynolo.ca
VITE_API_URL=https://beta-reelreview.bynolo.ca

# Postgres
POSTGRES_USER=postgresuser
POSTGRES_PASSWORD=replace-with-beta-db-password
POSTGRES_DB=reel_review_beta
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Ports
FRONTEND_PORT=3020
BACKEND_PORT=8020
DB_VIEWER_PORT=8082
PROXY_PORT=82

# KeyN OAuth Configuration
KEYN_CLIENT_ID=replace-with-beta-keyn-client-id
KEYN_CLIENT_SECRET=replace-with-beta-keyn-client-secret
KEYN_REDIRECT_URI=https://beta-reelreview.bynolo.ca/auth/callback
KEYN_BASE_URL=https://auth-keyn.bynolo.ca
VITE_KEYN_BASE_URL=https://auth-keyn.bynolo.ca

# Nolofication Settings
NOLOFICATION_URL=https://nolofication.bynolo.ca
NOLOFICATION_SITE_ID=reelreview-beta
NOLOFICATION_API_KEY=replace-with-beta-nolofication-api-key
ENABLE_WATCH_PARTY_REMINDERS=true

# JWT Auth settings
SECRET_KEY=replace-with-beta-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# TMDB API
TMDB_API_KEY=replace-with-tmdb-api-key

# Contact Details
VITE_SUPPORT_EMAIL=support.reelreview@bynolo.ca
