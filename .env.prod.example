APP_ENV_FILE=.env.prod
COMPOSE_PROJECT_NAME=reelreview-prod
PROJECT_NAME=Reel-Review
FRONTEND_URL=https://reelreview.bynolo.ca
VITE_API_URL=https://reelreview.bynolo.ca

# Postgres
POSTGRES_USER=postgresuser
POSTGRES_PASSWORD=replace-with-prod-db-password
POSTGRES_DB=reel_review_prod
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Ports
FRONTEND_PORT=3010
BACKEND_PORT=8010
DB_VIEWER_PORT=8081
PROXY_PORT=81

# KeyN OAuth Configuration
KEYN_CLIENT_ID=replace-with-prod-keyn-client-id
KEYN_CLIENT_SECRET=replace-with-prod-keyn-client-secret
KEYN_REDIRECT_URI=https://reelreview.bynolo.ca/auth/callback
KEYN_BASE_URL=https://auth-keyn.bynolo.ca
VITE_KEYN_BASE_URL=https://auth-keyn.bynolo.ca

# Nolofication Settings
NOLOFICATION_URL=https://nolofication.bynolo.ca
NOLOFICATION_SITE_ID=reelreview
NOLOFICATION_API_KEY=replace-with-prod-nolofication-api-key

# JWT Auth settings
SECRET_KEY=replace-with-prod-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# TMDB API
TMDB_API_KEY=replace-with-tmdb-api-key

# Contact Details
VITE_SUPPORT_EMAIL=support.reelreview@bynolo.ca
